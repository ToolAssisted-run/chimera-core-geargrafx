+#if defined(GG_CHIMERA)
+/* Built as a Chimera core (a frontend for tool-assisted speedruns). Chimera's
+ * adapter defines these; every use is under GG_CHIMERA. */
+extern unsigned int gg_chimera_random_seed; /* the power-on seed: a project setting, never the clock */
+extern bool gg_chimera_no_sgx;              /* the machine is a PC Engine: never a SuperGrafx */
+extern void gg_chimera_input_read(void);    /* the game read its controller port */
+/* How much of a disc image is kept in memory. Every piece kept is in every
+ * savestate, so a long game must not keep the whole disc. */
+#define GG_CHIMERA_CUE_CACHED_CHUNKS 8
+#define GG_CHIMERA_CHD_CACHED_HUNKS 16
+#endif
+
 #endif /* DEFINES_H */
