Chimera hooks for Geargrafx, all under GG_CHIMERA (defined only by this
repository's build, so upstream's own builds are unchanged):

- the power-on random seed comes from the project's settings, not time(NULL);
- the game reading its controller port is reported, for lag frames and for
  Chimera's input-poll callback;
- a PC Engine machine never becomes a SuperGrafx (by the game database or by
  a .sgx extension); the SuperGrafx is a machine of its own;
- a .cue disc keeps 8 pieces of its image in memory and a .chd disc 16 hunks,
  where upstream keeps every piece it ever read: what is kept is in every
  savestate.

diff --git a/src/cdrom_chd_image.cpp b/src/cdrom_chd_image.cpp
index bc78b91..9badaa8 100644
--- a/src/cdrom_chd_image.cpp
+++ b/src/cdrom_chd_image.cpp
@@ -584,6 +584,12 @@ bool CdRomChdImage::InitHunkCache()
         InitPointer(m_hunk_cache[i]);
     }
 
+#if defined(GG_CHIMERA)
+    for (u32 i = 0; i < GG_CHIMERA_CHD_CACHED_HUNKS; i++)
+        m_chimera_hunk_ring[i] = UINT32_MAX;
+    m_chimera_hunk_ring_pos = 0;
+#endif
+
     return true;
 }
 
@@ -609,6 +615,13 @@ bool CdRomChdImage::LoadHunk(u32 hunk_index)
 
     if (m_hunk_cache[hunk_index] == NULL)
     {
+#if defined(GG_CHIMERA)
+        u32 evicted = m_chimera_hunk_ring[m_chimera_hunk_ring_pos];
+        if ((evicted != UINT32_MAX) && (evicted < m_hunk_count))
+            SafeDeleteArray(m_hunk_cache[evicted]);
+        m_chimera_hunk_ring[m_chimera_hunk_ring_pos] = hunk_index;
+        m_chimera_hunk_ring_pos = (m_chimera_hunk_ring_pos + 1) % GG_CHIMERA_CHD_CACHED_HUNKS;
+#endif
         m_hunk_cache[hunk_index] = new u8[m_hunk_bytes];
 
         Debug("Caching hunk %u", hunk_index);
