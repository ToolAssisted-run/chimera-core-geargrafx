{
  "coreName": "Geargrafx",
  "systemId": "PCE",
  "systemNames": {
    "PCE": "PC Engine / TurboGrafx-16",
    "SGX": "SuperGrafx",
    "PCECD": "PC Engine CD",
    "PCELD": "LaserActive (LD-ROM2)"
  },
  "author": "Ignacio Sanchez (drhelius) and the Geargrafx contributors; Chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-geargrafx",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    4,
    8,
    4,
    128
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. Geargrafx's machine is about 20 MiB of objects, and the adapter keeps two 4 MiB pictures; big blocks land on the mmap heap. waterbox/run-wbx.c uses the same layout.",
  "video": {
    "_comment": "buffer capacity; the live size comes from GetVideoWidth/Height (256 to 512 wide and 240 high for most games; the LaserActive's picture is up to 1176x263).",
    "width": 1176,
    "height": 263,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 21477273,
    "vsyncDenominator": 358995,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "channels": 2,
    "rate": 44100,
    "get": "GetAudio"
  },
  "input": {
    "name": "PC Engine Controller",
    "_comment": "index order is the wire: Power, then players 1 to 5 (2 to 5 through the TurboTap) with Up Down Left Right I II Select Run III IV V VI each (III to VI are the Avenue Pad 6's), then the mouse's two buttons. The mouse is in port 1 when the port1 setting says so: its buttons are the console's I (right) and II (left), and its axes its movement this frame.",
